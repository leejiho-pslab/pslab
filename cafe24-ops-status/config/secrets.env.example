# 복사해서 config/secrets.env 로 저장하고 값을 채운다. (secrets.env 는 gitignore)

# 실행 모드: mock(샘플 데이터) | live(실제 API)
CAFE24_OPS_MODE=mock

# 카페24 Admin API
CAFE24_MALL_ID=maisonys
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_ACCESS_TOKEN=

# 광고 플랫폼 (Phase 2~)
# Meta: 토큰 + 광고계정 ID(sources.yaml 의 account_id 로도 지정 가능)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 네이버 검색광고(SearchAd) — 무료 API
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=
# 카카오모먼트 — 무료 API
KAKAO_ACCESS_TOKEN=
KAKAO_AD_ACCOUNT_ID=
# 네이버 데이터랩(경쟁사 검색 트렌드) — 무료 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 알림(선택) — Slack Incoming Webhook(무료)
SLACK_WEBHOOK_URL=
