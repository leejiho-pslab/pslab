# 복사해서 config/secrets.env 로 저장하고 값을 채운다. (secrets.env 는 gitignore)
# 디브릭은 자사몰이 없어 카페24 항목은 비워둔다(자동 스킵).

# 실행 모드: mock(샘플 데이터) | live(실제 API)
CAFE24_OPS_MODE=mock

# 광고 플랫폼
# Meta: 토큰 + 광고계정 ID(sources.yaml 의 account_id 로도 지정 가능)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Meta 장기토큰 자동 갱신용(선택, 넣으면 60일마다 재발급 불필요)
META_APP_ID=
META_APP_SECRET=
# Google Ads (후순위)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 네이버 검색광고(SearchAd) — 무료 API
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=
# 카카오모먼트 — 무료 API (후순위)
KAKAO_ACCESS_TOKEN=
KAKAO_AD_ACCOUNT_ID=
# 네이버 데이터랩(경쟁사 검색 트렌드) — 무료 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# GA4 — 광고 전환(conversions) 데이터 소스. 둘 다 있어야 활성화되며, 있으면
# 각 광고 플랫폼이 자체 보고하는 conversions 대신 GA4 채널별 값으로 대체된다.
# 채널 매핑(어떤 source/medium 이 어느 광고채널인지)은 config/ga4_channel_map.yaml 참고.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# 알림(선택) — Slack Incoming Webhook(무료)
SLACK_WEBHOOK_URL=
