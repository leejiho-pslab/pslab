# pslab-sns 자격 증명 예시
# 실제 값으로 채운 뒤 .env 로 복사하세요 (.env 는 git에 커밋되지 않습니다).
#
# 발행을 실제로 수행하려면 PSLAB_DRY_RUN=false 로 설정하세요. (기본값: true=시뮬레이션)
PSLAB_DRY_RUN=true
# 로그 레벨: debug | info | warn | error
PSLAB_LOG_LEVEL=info

# --- YouTube (Data API v3, OAuth2) ---
PSLAB_YOUTUBE_CLIENT_ID=
PSLAB_YOUTUBE_CLIENT_SECRET=
PSLAB_YOUTUBE_REFRESH_TOKEN=
PSLAB_YOUTUBE_CHANNEL_ID=

# --- 네이버 블로그 (오픈 API, OAuth2) ---
PSLAB_NAVER_BLOG_CLIENT_ID=
PSLAB_NAVER_BLOG_CLIENT_SECRET=
PSLAB_NAVER_BLOG_ACCESS_TOKEN=
PSLAB_NAVER_BLOG_BLOG_ID=

# --- Instagram (Graph API) ---
PSLAB_INSTAGRAM_ACCESS_TOKEN=
PSLAB_INSTAGRAM_IG_USER_ID=

# --- Threads (Threads API) ---
PSLAB_THREADS_ACCESS_TOKEN=
PSLAB_THREADS_THREADS_USER_ID=

# --- LinkedIn (Posts API) ---
PSLAB_LINKEDIN_ACCESS_TOKEN=
PSLAB_LINKEDIN_AUTHOR_URN=

# --- AI 콘텐츠 생성 (선택) ---
# ANTHROPIC_API_KEY 가 있으면 글을 Claude로 실제 생성합니다 (없으면 템플릿).
# @anthropic-ai/sdk 패키지도 필요합니다: npm i @anthropic-ai/sdk
ANTHROPIC_API_KEY=
# 사용할 모델 (기본: claude-opus-4-8)
PSLAB_CLAUDE_MODEL=claude-opus-4-8

# --- AI 이미지 생성 (기본: 무료 Pollinations) ---
# 기본 이미지 생성기는 Pollinations.ai (무료, 키 불필요). IMGBB_API_KEY만 있으면
# 이미지가 자동 생성·호스팅됩니다.
IMGBB_API_KEY=
# 이미지 생성기 선택: (미설정)=무료 Pollinations / gemini=유료 Gemini / none=끔
PSLAB_IMAGE_GEN=
# (선택) 유료 Gemini 나노바나나를 쓸 때만 — 빌링 연결된 프로젝트의 키
GEMINI_API_KEY=
PSLAB_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# (선택) 이미지 크기·모델
PSLAB_IMAGE_WIDTH=1080
PSLAB_IMAGE_HEIGHT=1080
PSLAB_POLLINATIONS_MODEL=flux
