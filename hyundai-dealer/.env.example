# 콘텐츠 자동 수집용 키 (GitHub Actions Secret 으로 주입, 저장소에 커밋 금지)

# [선택] YouTube Data API v3 키 — 없으면 공개 RSS 로 자동 수집(키 불필요)
YT_API_KEY=
# [선택] 수집할 YouTube 채널 ID (UC... 형식). 비우면 아래 채널 URL(@handle)에서 자동 해석
YT_CHANNEL_ID=
# 수집 대상 채널 URL (@handle). RSS 수집 시 사용
YT_CHANNEL_URL=https://www.youtube.com/@hyundai_moomoo
# 가져올 최신 영상 개수 (기본 6)
YT_MAX_RESULTS=6

# Instagram Graph API 장기 액세스 토큰 (비즈니스 계정 + 연결된 페이지 필요)
IG_ACCESS_TOKEN=
# Instagram 비즈니스 계정 ID (숫자). 미지정 시 토큰의 기본 계정 사용 시도
IG_USER_ID=
# 가져올 최신 게시물 개수 (기본 8)
IG_MAX_RESULTS=8

# 배포용 (선택)
# SITE_URL=https://hyundai-dealer.example.com
# SITE_BASE=/
