# 콘텐츠 자동 수집용 키 (GitHub Actions Secret 으로 주입, 저장소에 커밋 금지)

# YouTube Data API v3 키
YT_API_KEY=
# 수집할 YouTube 채널 ID (UC... 형식). 핸들 @hyundai_moomoo 의 채널 ID를 넣는다.
YT_CHANNEL_ID=
# 가져올 최신 영상 개수 (기본 6)
YT_MAX_RESULTS=6

# Instagram Graph API 장기 액세스 토큰 (비즈니스 계정 + 연결된 페이지 필요)
IG_ACCESS_TOKEN=
# Instagram 비즈니스 계정 ID (숫자). 미지정 시 토큰의 기본 계정 사용 시도
IG_USER_ID=
# 가져올 최신 게시물 개수 (기본 8)
IG_MAX_RESULTS=8

# 배포용 (선택)
# SITE_URL=https://hyundai-dealer.example.com
# SITE_BASE=/
