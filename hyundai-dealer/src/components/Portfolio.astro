---
import { site } from '../data/site.config';
const { title, description, items } = site.portfolio;
---

<section class="section section--dim" id="portfolio">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow" data-reveal>DELIVERY</p>
      <h2 class="headline" data-reveal data-reveal-delay="1">{title}</h2>
      <p class="lead" data-reveal data-reveal-delay="2">{description}</p>
    </div>

    <div class="folio">
      {items.map((p, i) => {
        const Tag = p.videoUrl ? 'a' : 'div';
        return (
          <Tag
            class:list={['folio__item', { 'folio__item--wide': i % 5 === 0 }]}
            href={p.videoUrl}
            target={p.videoUrl ? '_blank' : undefined}
            rel={p.videoUrl ? 'noopener' : undefined}
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div
              class="folio__media"
              data-variant={String(i % 4)}
              style={p.image ? `background-image:url('${p.image}')` : undefined}
            >
              {p.videoUrl && <span class="folio__play" aria-hidden="true">▶</span>}
            </div>
            <div class="folio__caption">
              <h3 class="folio__title">{p.title}</h3>
              <p class="folio__sub">{p.caption}</p>
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .folio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 2vw, 24px);
  }
  .folio__item {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0c0e12;
    color: #fff;
    border: 1px solid var(--line);
    aspect-ratio: 4 / 5;
    display: block;
  }
  .folio__item--wide { grid-column: span 2; aspect-ratio: 16 / 10; }

  .folio__media {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: transform 0.6s var(--ease);
    display: flex; align-items: center; justify-content: center;
  }
  .folio__media[data-variant='0'] { background-image: linear-gradient(160deg, #06283d, #00aad2); }
  .folio__media[data-variant='1'] { background-image: linear-gradient(160deg, #14161c, #39414f); }
  .folio__media[data-variant='2'] { background-image: linear-gradient(160deg, #002c5f, #0c7fa3); }
  .folio__media[data-variant='3'] { background-image: linear-gradient(160deg, #0f1117, #283142); }
  .folio__item:hover .folio__media { transform: scale(1.06); }

  .folio__media::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.72));
  }
  .folio__play {
    position: relative; z-index: 1;
    width: 60px; height: 60px; border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(6px); font-size: 1.1rem;
  }
  .folio__caption {
    position: absolute; inset: auto 0 0 0; z-index: 1;
    padding: 22px;
  }
  .folio__title { font-size: 1.12rem; }
  .folio__sub { margin: 4px 0 0; font-size: 0.9rem; color: rgba(255, 255, 255, 0.74); }

  @media (max-width: 880px) {
    .folio { grid-template-columns: repeat(2, 1fr); }
    .folio__item--wide { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .folio { grid-template-columns: 1fr; }
    .folio__item, .folio__item--wide { grid-column: auto; aspect-ratio: 4 / 3; }
  }
</style>
